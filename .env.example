# Environment Variables for Interpreter Agent Evaluation Framework
# Copy this file to .env and fill in your API keys
# DO NOT commit .env with actual keys to version control!

# OpenAI API Configuration
OPENAI_API_KEY=

# Google AI Studio Configuration
GEMINI_API_KEY=

# OpenRouter Configuration  
OPENROUTER_API_KEY=

# LM Studio: all local user models — multiple models loaded simultaneously
LM_STUDIO_BASE_URL=
# Indonesian user: SEA-LION v4 Qwen VL 8B
LM_STUDIO_ID_MODEL=qwen-sea-lion-v4-8b-vl
# Korean user: EXAONE-3.5-7.8B-Instruct
LM_STUDIO_KR_MODEL=exaone-3.5-7.8b-instruct
# Arabic user: c4ai-command-r7b-arabic-02-2025
LM_STUDIO_AR_MODEL=c4ai-command-r7b-arabic-02-2025
# Bengali user: TigerLLM-9B-Instruct
LM_STUDIO_BN_MODEL=tigerllm-9b-it

# vLLM Server Configuration
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL_NAME=

# Default Generation Settings
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1000
